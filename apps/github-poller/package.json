{
  "name": "@personal-events/github-poller",
  "version": "0.0.1",
  "description": "Long-running service that polls GitHub's Notifications inbox and Events API and writes canonical events to S3",
  "private": true,
  "type": "module",
  "bin": {
    "personal-events-github-poller": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "biome check src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/credential-providers": "catalog:",
    "@personal-events/event-model": "workspace:*",
    "@personal-events/event-sink": "workspace:*",
    "@personal-events/github": "workspace:*",
    "@personal-events/integration-core": "workspace:*",
    "effect": "catalog:",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
