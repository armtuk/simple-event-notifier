{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "biome.json", "pnpm-workspace.yaml"],
  "tasks": {
    // An explicit `inputs` array REPLACES turbo's default of all git-tracked package files, so
    // anything a task genuinely depends on must be listed. `exemplars/**` is in `build.inputs`
    // because @personal-events/event-model publishes its exemplars (its `files`/`exports` say so):
    // they are part of what a consumer builds against, so editing one must invalidate the
    // consumer's cached test run. Without it a drifted contract exemplar replays a cached PASS for
    // the consumer -- exactly the silent drift the shared-exemplar change exists to prevent.
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "exemplars/**", "tsup.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "types/**", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["src/**", "biome.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "exemplars/**", "vitest.config.ts"],
      "outputs": []
    },
    "plan": {
      "cache": false,
      "passThroughEnv": ["AWS_*", "TF_*"]
    },
    "deploy": {
      "cache": false,
      "dependsOn": ["build"],
      "passThroughEnv": ["AWS_*", "TF_*"]
    }
  }
}
